COMPOSE_PROJECT_NAME=dfl_master_manipulation
ROS_DOMAIN_ID=63
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
DFL_GPU_DEVICE=0
DFL_GENESIS_GPU_DEVICE=0
DFL_PERCEPTION_GPU_DEVICE=1
DFL_HEADLESS=true
DFL_ROBOT_MODEL=picker1
DFL_GRIPPER=vgc10_1cup
DFL_SCENE=empty
DFL_DRCF_VERSION=2
DFL_EMULATOR_MODEL=M1013
DFL_EMULATOR_PORT=12345
DFL_EMULATOR_CPUSET=0-3
DFL_OBJECT_ROOT=./objects
DFL_DATA_ROOT=./data
DFL_LOG_ROOT=./logs
DFL_MODEL_ROOT=./models
