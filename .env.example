# Real mode remains inert until Phase 07 commissioning supplies these values.
DFL_REAL_MOTION_ENABLED=0
DFL_PICKER1_HOST=UNCONFIGURED
DFL_PICKER1_RT_HOST=UNCONFIGURED
DFL_PICKER2_HOST=UNCONFIGURED
DFL_PICKER2_RT_HOST=UNCONFIGURED
