FROM nvcr.io/nvidia/cuda@sha256:e778509d37d66475120929671500377524f7278478ba08131b07ef3ffcc0dce0

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_APT_SOURCE_VERSION=1.1.0
ARG ROS_APT_SOURCE_SHA256=35441f3092fd05773a3c397fab38661bec466584c7a1f1c05366579997cb5fe7
ARG GENESIS_REF=76f8f5b3457e7c6d6a078de2244066f9a8694c45

ENV ROS_DISTRO=jazzy \
    ROS_WS=/root/ros2_ws \
    ROS_DOMAIN_ID=63 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    PYOPENGL_PLATFORM=egl \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates cmake curl git locales python3-dev \
       python3-pip python3-venv libegl1 libgl1 libglib2.0-0 libglu1-mesa \
       libsm6 libxext6 libxrender1 \
    && locale-gen en_US.UTF-8 \
    && curl -fsSL -o /tmp/ros2-apt-source.deb \
       "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.noble_all.deb" \
    && echo "${ROS_APT_SOURCE_SHA256}  /tmp/ros2-apt-source.deb" | sha256sum -c - \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm /tmp/ros2-apt-source.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python3-colcon-common-extensions python3-rosdep python3-vcstool python3-yaml \
       ros-jazzy-control-msgs ros-jazzy-rclpy ros-jazzy-rmw-cyclonedds-cpp \
       ros-jazzy-ros-base ros-jazzy-rosgraph-msgs ros-jazzy-tf2-ros \
       ros-jazzy-xacro \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/Genesis-Embodied-AI/genesis-world.git /opt/genesis-world \
    && git -C /opt/genesis-world checkout --detach "${GENESIS_REF}" \
    && test "$(git -C /opt/genesis-world rev-parse HEAD)" = "${GENESIS_REF}" \
    && python3 -m venv --system-site-packages /opt/genesis-venv

COPY config/genesis-requirements.lock /opt/dfl/genesis-requirements.lock

RUN /opt/genesis-venv/bin/python -m pip install --upgrade \
      'pip==25.2' 'setuptools==79.0.1' 'wheel==0.45.1' \
    && /opt/genesis-venv/bin/python -m pip install \
       --constraint /opt/dfl/genesis-requirements.lock \
       -e '/opt/genesis-world[render]'

ARG TORCH_VERSION=2.11.0
RUN /opt/genesis-venv/bin/python -m pip install \
      "torch==${TORCH_VERSION}" \
      --constraint /opt/dfl/genesis-requirements.lock \
      --index-url https://download.pytorch.org/whl/cu128

COPY scripts /opt/dfl/scripts
RUN chmod +x /opt/dfl/scripts/*.sh \
    && mkdir -p /root/ros2_ws/src /root/ros2_ws/build /root/ros2_ws/install /root/ros2_ws/log

ENV PATH=/opt/genesis-venv/bin:${PATH}
WORKDIR /root/ros2_ws
ENTRYPOINT ["/opt/dfl/scripts/ros_entrypoint.sh"]
CMD ["python", "-c", "import genesis; print(genesis.__version__)"]
