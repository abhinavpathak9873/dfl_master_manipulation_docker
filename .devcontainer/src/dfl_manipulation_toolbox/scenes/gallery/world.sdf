<?xml version="1.0"?>
<sdf version="1.9">
  <world name="gallery">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.35 0.35 0.38 1</ambient>
      <background>0.035 0.055 0.075 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light type="directional" name="key">
      <pose>3 -3 7 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.4 -0.75</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="directional" name="fill">
      <pose>-4 2 5 0 0 0</pose>
      <diffuse>0.45 0.50 0.60 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.6 -0.2 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.14 0.17 0.21 1</ambient><diffuse>0.18 0.22 0.27 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Gazebo cameras look along +X.  This pose frames the tallest Picker;
         the capture script crops the common 4:3 image without UI chrome. -->
    <model name="gallery_camera_rig">
      <static>true</static>
      <pose>3.4 -3.4 2.8 0 0.31 2.35619449</pose>
      <link name="camera_link">
        <sensor name="gallery_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/gallery/camera/image</topic>
          <camera>
            <horizontal_fov>0.82</horizontal_fov>
            <image><width>1280</width><height>960</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>20</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
