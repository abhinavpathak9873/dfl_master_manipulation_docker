<?xml version="1.0"?>
<package format="3">
  <name>dfl_genesis_integration</name>
  <version>0.1.0</version>
  <description>Direct Genesis 1.3.3 ROS bridge for the Phase 00 robot/tool matrix.</description>
  <maintainer email="robotics@dfl.ae">DFL Robotics</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>dfl_manipulation_toolbox</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
